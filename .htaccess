# =============================================================================
# Shared-hosting bridge.
#
# This file only matters when the *repository root* is the document root — the
# StackCP layout, e.g. /home/sites/.../quranreader.mfinnovation.xyz. It forwards
# every request into public_html/ so the front controller keeps working, and it
# refuses to serve anything that is not meant to be public.
#
# If the host can point the document root at public_html/ directly (preferred),
# Apache ignores this file and uses public_html/.htaccess instead.
# =============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application code, data, tooling and docs are never served.
    RewriteRule ^(app|bin|database|storage|qa|tools|delivery|browser-results)(/|$) - [F,L]

    # Dotfiles: .env, .git, .htaccess itself.
    RewriteRule (^|/)\. - [F,L]

    # Archives, database dumps and Windows helper scripts sitting in the root.
    RewriteRule \.(zip|tar|gz|sql|bat|ps1|md)$ - [F,L]

    # /public_html/... is canonicalised by public_html/.htaccess, not here:
    # measured on this host, a request that resolves inside public_html/ is
    # handled by that directory's .htaccess alone, so the parent rule never
    # runs. Keeping a second copy here would only be dead code (and a loop
    # risk if the docroot ever moves down to public_html/).

    # Already inside the web root — leave the request untouched.
    RewriteCond %{REQUEST_URI} !^/public_html/
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>

# Fallback for hosts without mod_rewrite: keep the sensitive folders closed.
<IfModule !mod_rewrite.c>
    RedirectMatch 404 ^/(app|bin|database|storage|qa|tools|delivery)/
</IfModule>
