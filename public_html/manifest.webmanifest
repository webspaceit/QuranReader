{
    "id": "./",
    "name": "Quran Reader",
    "short_name": "Quran",
    "description": "Read the Quran with Uthmani script, trusted translations and verse-by-verse recitation. Works offline.",
    "lang": "en",
    "dir": "ltr",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait-primary",
    "background_color": "#FAF8F2",
    "theme_color": "#0F5132",
    "categories": ["books", "education", "lifestyle"],
    "icons": [
        {
            "src": "assets/img/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "assets/img/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "assets/img/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Continue reading",
            "short_name": "Read",
            "url": "./surah.php?n=1",
            "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Search the Quran",
            "short_name": "Search",
            "url": "./search.php",
            "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Bookmarks and notes",
            "short_name": "Saved",
            "url": "./bookmarks.php",
            "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
        }
    ]
}
