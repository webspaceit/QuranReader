# -----------------------------------------------------------------------------
# Quran Reader — Apache configuration for shared hosting
# -----------------------------------------------------------------------------

DirectoryIndex index.php

# No directory listings.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# -----------------------------------------------------------------------------
# Block access to sensitive files and folders.
# These rules matter when the whole project is uploaded inside public_html.
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# _bootstrap.php and any other underscore-prefixed internal file.
<FilesMatch "^_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|md|ini|env|bak|old|sh|ps1|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Internal directories, if they happen to sit inside the web root. The pattern
# is unanchored so it also matches when the site is installed in a subdirectory.
RedirectMatch 404 /(app|storage|database|bin|tests|qa|vendor)/

# -----------------------------------------------------------------------------
# Friendly 404s: send unknown paths to 404.php (works in a subdirectory too,
# unlike a leading-slash ErrorDocument). Existing files and folders are served
# normally.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# Compression (large text payloads: surah pages can be a few hundred KB).
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Caching. HTML stays uncached so content changes are instant.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png|jpg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, private"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# PHP settings that are safe to request on shared hosting. Wrapped so a host
# that forbids these directives does not return a 500 error.
# -----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# -----------------------------------------------------------------------------
# Progressive web app. The manifest needs its own MIME type, and the service
# worker must never be served from cache: a stale sw.js pins readers to an old
# cache version.
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        ExpiresActive On
        ExpiresByType application/javascript "access plus 0 seconds"
        ExpiresByType application/manifest+json "access plus 0 seconds"
        ExpiresDefault "access plus 0 seconds"
    </FilesMatch>
</IfModule>
