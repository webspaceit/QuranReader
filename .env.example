# =============================================================================
# Quran Reader — environment template
#
# Copy to `.env` in the project root and edit. Nothing else has to be edited by
# hand: app/config/config.php is optional.
#
#   cp .env.example .env
#
# Precedence (later wins):
#   1. app/config/defaults.php   (shipped structure)
#   2. app/config/config.php     (optional legacy / local overrides)
#   3. .env                      (this file — the normal place to configure)
#   4. real environment variables (e.g. set by the host panel or Docker)
#
# `.env` must never be committed or served: it is git-ignored, excluded from the
# release archive, and denied by .htaccess in case the project is uploaded above
# the web root.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Quran Reader"
# No trailing slash. Drives canonical URLs, emails and the PWA manifest scope.
APP_URL="https://example.com"
# production | local. Anything other than "local" disables debug output.
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en
# Optional super admin: this account always gets the admin dashboard, even
# before the is_admin flag is set. Leave empty to nominate nobody.
APP_ADMIN_EMAIL=

# --- Database (cPanel > MySQL Databases) -------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_quran
DB_USERNAME=cpuser_quran
DB_PASSWORD="change-me"
DB_CHARSET=utf8mb4

# --- Sessions and cookies ----------------------------------------------------
SESSION_NAME=quran_session
# Seconds: 30 days absolute, 3 hours idle.
SESSION_LIFETIME=2592000
SESSION_IDLE_TIMEOUT=10800
# auto = on whenever the request is HTTPS. Use "1" to force it behind a proxy.
SESSION_COOKIE_SECURE=auto
SESSION_SAME_SITE=Lax
# SESSION_COOKIE_DOMAIN=.example.com

# --- Security ----------------------------------------------------------------
# "true" only when the app sits behind a trusted reverse proxy / CDN.
SECURITY_TRUST_PROXY=false
# Seconds of HSTS; 0 disables the header.
SECURITY_HSTS_MAX_AGE=31536000
# Comma-separated list; leave empty to disable CORS for the JSON API.
# SECURITY_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Quran content API -------------------------------------------------------
QURAN_API_BASE_URL="https://api.alquran.cloud/v1"
QURAN_API_TIMEOUT=25
QURAN_API_RETRIES=2
QURAN_API_USER_AGENT="QuranWebsite/1.0 (+https://example.com)"
# Path to a CA bundle when the host cannot verify TLS certificates.
# CURL_CA_BUNDLE=/home/cpuser/ssl/cacert.pem

# --- Content shipped to readers ----------------------------------------------
# Editions imported by bin/import-quran.php and offered in the pickers.
CONTENT_TRANSLATIONS=en.sahih,en.pickthall,en.yusufali,en.hilali,bn.bengali,bn.hoque
CONTENT_DEFAULT_TRANSLATION=en.sahih
CONTENT_AUDIO_BASE="https://cdn.islamic.network/quran/audio"

# --- Mail --------------------------------------------------------------------
# log | mail | smtp. "log" writes .eml files to storage/logs/mail instead of
# sending, which is the safe default until a sender is configured.
MAIL_TRANSPORT=log
MAIL_FROM="no-reply@example.com"
MAIL_FROM_NAME="Quran Reader"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# --- Maintenance -------------------------------------------------------------
# Required for POST /api/cron/sync.php?token=...
# Generate with: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
SYNC_TOKEN=
SYNC_COOLDOWN_HOURS=24
